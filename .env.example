# ---------------------------------------------------------------- App
APP_NAME="JS Coretech"
APP_URL=http://localhost:3000
# Every date in the app (and in the database session) uses this zone
TZ=Asia/Kolkata
# 32+ random characters; signs the login cookies. `openssl rand -hex 32`
SESSION_SECRET=
# Hours a session lasts without "Remember me" (with it: 30 days)
SESSION_HOURS=12

# ---------------------------------------------------------------- PostgreSQL
DATABASE_URL=postgres://localhost:5432/wa_next
DB_POOL_MAX=20

# ---------------------------------------------------------------- Files
# Uploads that Meta must fetch by URL (served at /media/...)
MEDIA_PATH=./storage/media
# Base64 attachment payloads saved by the public API
API_MEDIA_PATH=./storage/api_media

# ---------------------------------------------------------------- WhatsApp / Meta Cloud API
WA_API_URL=https://graph.facebook.com/v25.0/
# System-user token; a js_master_value row WA_KEY_MASTER_ID overrides it
WA_KEY=
WA_KEY_MASTER_ID=56203
WA_COUNTRY_CODE=91
# Empty = accept any token (the legacy behaviour)
WA_WEBHOOK_VERIFY_TOKEN=
# Set it to verify X-Hub-Signature-256 on webhooks
META_APP_SECRET=
# Embedded Signup on the user dashboard
FB_APP_ID=
FB_CONFIG_ID=
WA_REGISTER_PIN=
# Queue sender window (hours, 24h clock) and batch size per user per run (send-queue runs every minute:
# 1000 = up to ~1000 messages per minute per WhatsApp account)
WA_SEND_START_HOUR=7
WA_SEND_END_HOUR=23
WA_SEND_BATCH=1000
# Parallel Meta requests per account while sending the queue
WA_SEND_CONCURRENCY=16
# Messages older than this (seconds) are no longer "in queue"
WA_QUE_TIME=259200
# Outgoing messages older than this many seconds are never sent and get expired (24h)
WA_MSG_EXPIRY=86400

# ---------------------------------------------------------------- Payments (1 = Razorpay, 2 = CCAvenue)
PAYMENT_GATEWAY=2
RAZORPAY_KEY=
RAZORPAY_SECRET=
CCA_MERCHANT_ID=
CCA_ACCESS_CODE=
CCA_WORKING_KEY=
CCA_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction
F_YEAR=23-24

# ---------------------------------------------------------------- Shopify (legacy waapi/shopify.php was wired to user 74)
SHOPIFY_USER_ID=74
SHOPIFY_ORDER_TEMPLATE=order_confirmation
SHOPIFY_CART_TEMPLATE=abandoned_checkout
SHOPIFY_WEBHOOK_SECRET=

# Api-Key header for waapi/client_api.php; empty = not checked
CLIENT_API_KEY=

# ---------------------------------------------------------------- Mail (MAIL_MAILER=log prints mails to the worker log)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="JS Coretech"

# ---------------------------------------------------------------- Daily email reports
REPORT_ADMIN_EMAIL=
REPORT_BCC_EMAIL=
REPORT_TEMPLATE_USERS=46
REPORT_EMAIL_TIME=23:30

SITE_SUPPORT_NO=
SITE_SUPPORT_EMAIL=
