# Public base URL for uploaded files (DigitalOcean Spaces CDN in production)
MEDIA_URL=http://localhost:3000/media/
# 32+ random characters: `openssl rand -base64 48`
SESSION_SECRET=

# ---- Passwords ----
# $salt from the old config/general.php (Common::EncPass). Needed to check passwords
# not yet upgraded to bcrypt. Not stored in the repo.
