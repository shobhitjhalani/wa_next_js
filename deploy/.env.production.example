# Production environment — copy to /var/www/wa/shared/.env on the droplet and fill in.
# chmod 600 /var/www/wa/shared/.env  (only the deploy user should read it)
NODE_ENV=production

# ---- App ----
SITE_URL=https://new.wa.jscoretech.com/          # parallel test; later https://wa.jscoretech.com/
SITE_NAME="JS Coretech"
MEDIA_URL=https://new.wa.jscoretech.com/media/   # served by Nginx straight from MEDIA_ROOT
# Generate with: openssl rand -base64 48   (changing it logs everyone out)
SESSION_SECRET=

# ---- Files on disk (outside the release folders so deploys don't wipe them) ----
MEDIA_ROOT=/var/www/wa/shared/media
WAAPI_MEDIA_ROOT=/var/www/wa/shared/storage/waapi-media

# ---- Passwords ----
# $salt from the old config/general.php (Common::EncPass). Needed to check passwords
# not yet upgraded to bcrypt. Not stored in the repo.
LEGACY_PASSWORD_SALT=

# ---- Database (DigitalOcean Managed PostgreSQL) ----
# Use the PRIVATE (VPC) host from the DO control panel, port 25060, the app user (not doadmin).
# sslmode=require is mandatory on Managed PG. connection_limit is per Node process:
# 2 web instances + 1 worker -> keep (instances+1) * limit below the pool/plan limit.
DATABASE_URL="postgresql://wa_app:PASSWORD@private-db-xxxx.b.db.ondigitalocean.com:25060/wa_jscoretech?sslmode=require&connection_limit=8&pool_timeout=20"

# ---- WhatsApp Cloud API (Meta) ----
# REAL endpoint. Setting this means the worker WILL send messages to customers.
WA_API_URL=https://graph.facebook.com/v25.0/
# Fallback only: the live token is read from js_master_value row 56203.
WA_KEY=
WABA_ID=
WA_WEBHOOK_VERIFY_TOKEN=
QUE_TIME=259200
# Worker: seconds between passes of each queue lane.
# WORKER_ENABLED=0 keeps the queue worker out of PM2 (test phase). Remove at cut-over.
WORKER_ENABLED=0
WORKER_INTERVAL_SECONDS=60

# ---- Email (Amazon SES SMTP) — rotate the credentials that were in config/general.php ----
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_EMAIL_FROM=noreply@support.jscoretech.com

# ---- Payments (live keys) ----
CCA_MERCHANT_MID=
CCA_ACCESS_CODE=
CCA_WORKING_KEY=

# ---- Support contact ----
SUPPORT_NO="+91 9784550999"
SUPPORT_EMAIL=support@jscoretech.com
